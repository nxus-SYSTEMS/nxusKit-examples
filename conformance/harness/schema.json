{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nxuskit.dev/schemas/examples-manifest.json",
  "title": "nxusKit Examples Manifest",
  "description": "Schema for cross-language example parity manifest (v5.1.0 — adds structured real_world_applications array)",
  "type": "object",
  "required": [
    "version",
    "examples"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "version": {
      "type": "string",
      "description": "Manifest schema version",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the manifest"
    },
    "examples": {
      "type": "array",
      "description": "List of examples that should exist in all implementations",
      "items": {
        "$ref": "#/$defs/example"
      }
    },
    "language_display_names": {
      "type": "object",
      "description": "Maps machine-facing language keys to human-facing display names (e.g., bash → CLI/Bash)",
      "additionalProperties": {
        "type": "string"
      }
    },
    "categories": {
      "type": "object",
      "description": "Category definitions",
      "additionalProperties": {
        "$ref": "#/$defs/category"
      }
    }
  },
  "$defs": {
    "example": {
      "type": "object",
      "required": [
        "name",
        "description",
        "category",
        "implementations",
        "scenario",
        "real_world_application",
        "tech_tags",
        "languages",
        "tier"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique identifier for the example (kebab-case)",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of what the example demonstrates"
        },
        "category": {
          "type": "string",
          "description": "Category this example belongs to",
          "enum": [
            "patterns",
            "integrations",
            "apps"
          ]
        },
        "required": {
          "type": "boolean",
          "description": "Whether this example must exist in all implementations",
          "default": false
        },
        "scenario": {
          "type": "string",
          "description": "Short phrase describing the scenario demonstrated"
        },
        "real_world_application": {
          "type": "string",
          "description": "Short phrase describing the real-world use case"
        },
        "tech_tags": {
          "type": "array",
          "description": "Technology tags from the approved tag key",
          "items": {
            "type": "string",
            "enum": [
              "LLM",
              "CLIPS",
              "Solver",
              "BN",
              "ZEN",
              "MCP",
              "Vision",
              "Streaming",
              "Auth",
              "OAuth"
            ]
          },
          "minItems": 1
        },
        "languages": {
          "type": "array",
          "description": "Array of implemented languages, must match implementations keys",
          "items": {
            "type": "string",
            "enum": [
              "rust",
              "go",
              "python",
              "bash"
            ]
          },
          "minItems": 1
        },
        "implementations": {
          "type": "object",
          "description": "Paths to implementations in each language",
          "properties": {
            "rust": {
              "type": "string",
              "description": "Path to Rust implementation"
            },
            "go": {
              "type": "string",
              "description": "Path to Go implementation"
            },
            "python": {
              "type": "string",
              "description": "Path to Python implementation"
            },
            "bash": {
              "type": "string",
              "description": "Path to Bash/CLI implementation (via nxuskit-cli)"
            }
          },
          "additionalProperties": false
        },
        "frontends": {
          "type": "array",
          "description": "Optional, first-class interactive frontends for an existing language implementation. A frontend does not add a language or replace the canonical implementation.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "language",
              "entrypoint",
              "documentation",
              "default_mode",
              "community_offline",
              "requires_explicit_analyze"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable frontend identifier within the example.",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "kind": {
                "type": "string",
                "description": "Interactive frontend runtime.",
                "enum": [
                  "marimo"
                ]
              },
              "language": {
                "type": "string",
                "description": "Existing implementation language that owns the frontend.",
                "enum": [
                  "python"
                ]
              },
              "entrypoint": {
                "type": "string",
                "description": "Repository-relative ordinary-source entrypoint for the frontend.",
                "pattern": "^examples/"
              },
              "documentation": {
                "type": "string",
                "description": "Repository-relative frontend setup and operation guide.",
                "pattern": "^examples/"
              },
              "default_mode": {
                "type": "string",
                "description": "Safe, no-credential default frontend mode.",
                "enum": [
                  "fixture"
                ]
              },
              "community_offline": {
                "type": "boolean",
                "description": "Whether the default Community journey completes without a provider, network, or entitlement.",
                "const": true
              },
              "requires_explicit_analyze": {
                "type": "boolean",
                "description": "Whether provider or reasoning execution requires an explicit user submission.",
                "const": true
              }
            },
            "additionalProperties": false
          }
        },
        "tier": {
          "type": "string",
          "description": "Scalar SDK edition tier for compatibility with existing consumers.",
          "enum": [
            "community",
            "pro"
          ]
        },
        "tags": {
          "type": "array",
          "description": "Tags for filtering and organization",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "description": "Other examples this one depends on",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string",
          "description": "Optional notes about the example"
        },
        "edition_note": {
          "type": "string",
          "description": "Optional human-facing note for examples with Community defaults and optional higher-tier enhancements."
        },
        "tier_profile": {
          "$ref": "#/$defs/tier_profile"
        },
        "tagline": {
          "type": "string",
          "description": "Short editorial hook (15-30 words). Used in README blockquote, website cards, Saved Interests context, MCP search results, and CLI output.",
          "minLength": 10,
          "maxLength": 200
        },
        "blurb": {
          "type": "string",
          "description": "Extended editorial paragraph (50-100 words, inverted pyramid structure). Used in MCP detail, future per-example detail pages, and marketing materials.",
          "minLength": 30,
          "maxLength": 750
        },
        "content_hash": {
          "type": "string",
          "description": "SHA-256 hash of inputs used to generate tagline/blurb. Used by CI staleness check.",
          "pattern": "^[a-f0-9]{64}$"
        },
        "difficulty": {
          "type": "string",
          "description": "Developer skill level required to understand and modify this example.",
          "enum": [
            "starter",
            "intermediate",
            "advanced"
          ]
        },
        "difficulty_override": {
          "type": "boolean",
          "description": "True if difficulty was manually overridden from the auto-computed value."
        },
        "difficulty_override_reason": {
          "type": "string",
          "description": "Reason for manual difficulty override. Required when difficulty_override is true."
        },
        "scenarios": {
          "type": "array",
          "description": "Named scenarios supported by this example. Omit for single-scenario examples. Each entry has a name, description, and CLI invocation.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "description",
              "cli"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Short scenario identifier (kebab-case, used in CLI flags and display)"
              },
              "description": {
                "type": "string",
                "description": "One-line description of what this scenario demonstrates (10-25 words)"
              },
              "cli": {
                "type": "string",
                "description": "CLI flag or argument to invoke this scenario (e.g., '--scenario maze-rat')"
              }
            },
            "additionalProperties": false
          },
          "minItems": 2
        },
        "real_world_applications": {
          "type": "array",
          "description": "Structured real-world applications for this example. Each item maps a README-facing application label to a concise outcome description.",
          "items": {
            "type": "object",
            "required": [
              "label",
              "description"
            ],
            "properties": {
              "label": {
                "type": "string",
                "description": "Short application or domain label, for example Event planning or Manufacturing",
                "minLength": 2
              },
              "description": {
                "type": "string",
                "description": "Concise description of how the example pattern applies in that domain",
                "minLength": 5
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        }
      }
    },
    "tier_profile": {
      "type": "object",
      "description": "Enhanced tier metadata for examples whose default scalar tier remains simple but optional stages may use additional tiers.",
      "required": [
        "schema_version",
        "minimum_tier",
        "tiers",
        "default_stage",
        "summary",
        "stages"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "minimum_tier": {
          "type": "string",
          "enum": [
            "community",
            "pro"
          ]
        },
        "tiers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "community",
              "pro"
            ]
          },
          "minItems": 1
        },
        "default_stage": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "badges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "kind"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "tier",
              "required",
              "enabled_by_default",
              "requires_entitlement",
              "capabilities",
              "fallback"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "tier": {
                "type": "string",
                "enum": [
                  "community",
                  "pro"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "enabled_by_default": {
                "type": "boolean"
              },
              "requires_entitlement": {
                "type": "boolean"
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "fallback": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "category": {
      "type": "object",
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string",
          "description": "Human-readable description of the category"
        },
        "required": {
          "type": "boolean",
          "description": "Whether examples in this category are required",
          "default": false
        }
      }
    }
  }
}
