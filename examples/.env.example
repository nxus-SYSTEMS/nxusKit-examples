# LLMKit Examples - Environment Variables
# Copy this file to .env and fill in your values

# OpenAI API Key (optional - for commercial provider testing)
OPENAI_API_KEY=sk-your-key-here

# Anthropic API Key (optional - for Claude provider testing)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Ollama Host (default: http://localhost:11434)
# Ollama is free and runs locally - recommended for development
OLLAMA_HOST=http://localhost:11434

# Default model to use (optional)
# Examples: llama3, gpt-4o-mini, claude-3-haiku-20240307
DEFAULT_MODEL=llama3
